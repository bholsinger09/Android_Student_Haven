<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:orientation="horizontal"
    android:gravity="center_vertical" android:background="@drawable/bg_card"
    android:padding="16dp" android:minHeight="72dp">
    <ImageView android:id="@+id/icon" android:layout_width="42dp"
        android:layout_height="42dp" android:layout_marginEnd="14dp"
        android:background="@drawable/bg_badge" android:padding="9dp"
        app:tint="@color/purple" android:importantForAccessibility="no"
        android:src="@drawable/ic_book" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/subtitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:textSize="14sp" android:textColor="@color/secondary_text" />
        <TextView android:id="@+id/meta" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:textColor="@color/purple" android:textSize="12sp" />
    </LinearLayout>
    <ImageView android:id="@+id/chevron" android:layout_width="16dp"
        android:layout_height="16dp" android:layout_marginStart="8dp"
        android:src="@drawable/ic_chevron" app:tint="@color/secondary_text"
        android:importantForAccessibility="no" />
</LinearLayout>
