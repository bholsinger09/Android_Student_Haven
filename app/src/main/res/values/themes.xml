<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StudentHaven" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple</item>
        <item name="colorPrimaryDark">@color/background</item>
        <item name="colorAccent">@color/purple</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="android:textViewStyle">@style/HavenText</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="HavenText" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/primary_text</item>
    </style>
    <style name="Theme.StudentHaven.Editor" parent="Theme.StudentHaven">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="HavenAction" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/purple</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
    </style>
    <style name="HavenPrimary" parent="HavenAction">
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="HavenTab" parent="HavenAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/tab_tint</item>
        <item name="drawableTint">@color/tab_tint</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
